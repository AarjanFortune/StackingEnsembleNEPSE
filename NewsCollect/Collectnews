import os
import re
import time
import requests
import pandas as pd
from bs4 import BeautifulSoup
from urllib.parse import urljoin
from datetime import date, datetime, timedelta
from concurrent.futures import ThreadPoolExecutor

# ---------- CONFIG ----------
BASE_URL = "https://www.sharesansar.com/category/latest"
TOKEN = "kXv0PoCD9Ioz0uZo3cjdZ5Qm6A7eoPD5168Ag9Wi"  # Replace with valid token
OUTPUT_CSV = "sharesansar_news.csv"
DONE_FILE = "sharesansar_done_dates.txt"     # checkpoint: dates fully scraped and saved

START_DATE = date(2012, 1, 1)
END_DATE = date(2026, 11, 22)

DETAIL_WORKERS = 6        # parallel article-page requests per day (keep modest)
DETAIL_DELAY = 0.2        # seconds each worker waits after a request
SAVE_EVERY_DAYS = 100     # write to CSV after this many completed days

COLUMNS = ["Date", "Time", "Published_At", "Headline", "Link"]

HEADERS = {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                  "AppleWebKit/537.36 (KHTML, like Gecko) "
                  "Chrome/124.0.0.0 Safari/537.36"
}

# Matches e.g. "Mon, Nov 23, 2026 10:56 AM"
TS_PATTERN = re.compile(r"[A-Za-z]{3}, [A-Za-z]{3} \d{1,2}, \d{4} \d{1,2}:\d{2} [AP]M")


# ---------- PUBLICATION TIME (from article page) ----------
def get_publish_datetime(article_url):
    """Return the datetime shown on the article page, or None."""
    try:
        response = requests.get(article_url, headers=HEADERS, timeout=20)
        soup = BeautifulSoup(response.text, "html.parser")
        for h5 in soup.select("h5"):
            if h5.select_one("i.fa-calendar"):
                match = TS_PATTERN.search(h5.get_text(" ", strip=True))
                if match:
                    return datetime.strptime(match.group(0), "%a, %b %d, %Y %I:%M %p")
    except requests.RequestException:
        pass
    return None


def fetch_publish_time(article):
    """Worker: look up one article's publication time."""
    headline, link = article
    pub_dt = get_publish_datetime(link)
    time.sleep(DETAIL_DELAY)
    return headline, link, pub_dt


# ---------- LISTING (all pages for one day) ----------
def fetch_listing_articles(date_str):
    """Return [(headline, link)] for every page of one day's listing."""
    articles = []
    next_url = f"{BASE_URL}?company=&date={date_str}&_token={TOKEN}"
    while next_url:
        response = requests.get(next_url, headers=HEADERS, timeout=20)
        soup = BeautifulSoup(response.text, "html.parser")

        news_blocks = soup.select("div.featured-news-list")
        if not news_blocks:
            break

        for block in news_blocks:
            try:
                a_tag = block.select_one("div.col-md-10 a")
                headline = a_tag.select_one("h4.featured-news-title").get_text(strip=True)
                articles.append((headline, a_tag["href"]))
            except (AttributeError, KeyError, TypeError):
                continue

        next_tag = soup.select_one("ul.pagination li a[rel='next']")
        next_url = urljoin(BASE_URL, next_tag["href"]) if next_tag else None
    return articles


def scrape_day(date_str):
    """Scrape one day: listing pages first, then article times in parallel."""
    articles = fetch_listing_articles(date_str)
    if not articles:
        return []

    with ThreadPoolExecutor(max_workers=DETAIL_WORKERS) as pool:
        results = list(pool.map(fetch_publish_time, articles))  # keeps order

    rows = []
    for headline, link, pub_dt in results:
        publish_time = pub_dt.strftime("%H:%M") if pub_dt else None
        published_at = pub_dt.strftime("%Y-%m-%d %H:%M:%S") if pub_dt else None
        rows.append((date_str, publish_time, published_at, headline, link))
    return rows


# ---------- CHECKPOINTING ----------
def load_done_dates():
    if not os.path.exists(DONE_FILE):
        return set()
    with open(DONE_FILE, encoding="utf-8") as f:
        return {line.strip() for line in f if line.strip()}


def save_batch(rows, days):
    """Append rows to the CSV, then record the days as done."""
    if rows:
        new_file = not os.path.exists(OUTPUT_CSV)
        pd.DataFrame(rows, columns=COLUMNS).to_csv(
            OUTPUT_CSV,
            mode="a",
            header=new_file,
            index=False,
            # BOM only on the first write so Excel reads the file correctly
            encoding="utf-8-sig" if new_file else "utf-8",
        )
    with open(DONE_FILE, "a", encoding="utf-8") as f:
        f.write("\n".join(days) + "\n")


# ---------- MAIN LOOP ----------
all_dates = []
current = START_DATE
while current <= END_DATE:
    all_dates.append(current.strftime("%Y-%m-%d"))
    current += timedelta(days=1)

done = load_done_dates()
pending = [d for d in all_dates if d not in done]
print(f"{len(done)} days already done, {len(pending)} to scrape")

buffer_rows, buffer_days = [], []
started = time.time()
try:
    for i, date_str in enumerate(pending, 1):
        print(f"Scraping news for {date_str} ({i}/{len(pending)})")
        try:
            rows = scrape_day(date_str)
        except requests.RequestException as e:
            # Not marked done, so the next run retries this day
            print(f"  Network error, will retry next run: {e}")
            continue

        if not rows:
            print("  No news found")
        buffer_rows.extend(rows)
        buffer_days.append(date_str)

        if len(buffer_days) >= SAVE_EVERY_DAYS:
            save_batch(buffer_rows, buffer_days)
            buffer_rows, buffer_days = [], []
            print(f"  💾 Progress saved ({time.time() - started:.0f}s elapsed)")
finally:
    # Also runs on Ctrl+C or a crash, so finished days are not lost
    if buffer_days:
        save_batch(buffer_rows, buffer_days)

if os.path.exists(OUTPUT_CSV):
    total = sum(1 for _ in open(OUTPUT_CSV, encoding="utf-8-sig")) - 1
    print(f"\n✅ {OUTPUT_CSV} has {total} headlines")
else:
    print("⚠️ No data scraped.")
